# Copy to .env and export, or pass these to docker compose.
# The service answers with the extractive reader when no LLM key is set.

RAGQA_VECTOR_STORE=memory
RAGQA_EMBEDDER=sentence-transformers
RAGQA_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAGQA_LLM=auto

# PostgreSQL + pgvector (docker compose sets this on the api service)
# DATABASE_URL=postgresql://ragqa:ragqa@localhost:5432/ragqa

# Optional hosted LLMs and embeddings. Unused unless RAGQA_LLM / RAGQA_EMBEDDER selects them.
# OPENAI_API_KEY=
# RAGQA_OPENAI_MODEL=gpt-4o-mini
# RAGQA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=
# RAGQA_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional hosted vector stores. The adapters are loaded only when selected.
# PINECONE_API_KEY=
# PINECONE_INDEX=
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=
# WEAVIATE_COLLECTION=RagqaChunk
